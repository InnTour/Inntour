node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build Output (if using build tools)
dist/
build/

# Environment Files
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary Files
*.tmp
*.temp
tmp/
temp/

# Backup Files
*.bak
*.backup
*-backup.*

# Large Media (commit only optimized versions)
# Uncomment if you want to ignore large unoptimized images
